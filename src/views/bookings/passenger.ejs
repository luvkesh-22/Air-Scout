<%- include('../partials/header') %>

<!-- SNOW BACKGROUND -->
<div class="snow-container fixed inset-0 z-[5] pointer-events-none"></div>

<!-- MAIN CONTENT -->
<div class="relative z-10 bg-transparent min-h-screen flex items-center justify-center px-4">
      <div class="w-full max-w-4xl grid md:grid-cols-2 gap-6">

   <!-- LEFT: FLIGHT SUMMARY -->
<div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-lg">

  <div class="flex items-center justify-between mb-5">
    <div>
      <h3 class="text-xl font-bold text-white">
        Flight Summary ✈️
      </h3>

      <p class="text-sm text-gray-400 mt-1">
        Economy • Non-stop
      </p>
    </div>

    <div class="bg-orange-500/20 text-orange-300 px-3 py-1 rounded-full text-sm">
      Saver Fare
    </div>
  </div>

  <!-- AIRLINE -->
  <div class="mb-5">
    <p class="text-gray-400 text-sm">Airline</p>

    <div class="flex items-center gap-3 mt-1">
      <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-lg">
        ✈️
      </div>

      <div>
        <p class="text-white font-semibold">
          <%= flight.airline || "Air Scout Airways" %>
        </p>

        <p class="text-xs text-gray-400">
          Flight ID: <%= flight.id %>
        </p>
      </div>
    </div>
  </div>

  <!-- ROUTE -->
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-3xl font-bold text-white">
<%= flight.from_code || flight.from %>        </p>

        <p class="text-gray-400 text-sm">
          Departure
        </p>
      </div>

      <div class="flex-1 px-4 relative">
        <div class="h-[2px] bg-gray-600"></div>

        <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-xs">
          ✈️
        </span>
      </div>

      <div class="text-right">
        <p class="text-3xl font-bold text-white">
<%= flight.to_code || flight.to %>
        </p>

        <p class="text-gray-400 text-sm">
          Arrival
        </p>
      </div>
    </div>
  </div>

  <!-- TIMING -->
  <div class="space-y-3 border-t border-white/10 pt-4">

    <div class="flex justify-between text-sm">
      <span class="text-gray-400">Departure Time</span>
 <span class="text-white">
  <%= flight.departure_time 
      ? new Date(flight.departure_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) 
      : "08:30 AM" %>
</span>
    </div>

    <div class="flex justify-between text-sm">
      <span class="text-gray-400">Arrival Time</span>

   <span class="text-white">
  <%= flight.arrival_time 
      ? new Date(flight.arrival_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) 
      : "11:15 AM" %>
</span>
    </div>

    <div class="flex justify-between text-sm">
      <span class="text-gray-400">Travel Time</span>

      <span class="text-white">
        2h 45m
      </span>
    </div>

  </div>

  <!-- PRICE -->
  <div class="mt-6 pt-5 border-t border-white/10 flex items-center justify-between">

    <div>
      <p class="text-gray-400 text-sm">
        Total Amount
      </p>

      <p class="text-orange-400 text-3xl font-bold">
        ₹ <%= flight.price %>
      </p>
    </div>

    <div class="text-right text-xs text-gray-400">
      Includes taxes & fees
    </div>

  </div>

</div>
    

    <!-- RIGHT: PASSENGER FORM -->
<div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-lg animate-fadeUp">
      <h2 class="text-xl font-bold text-purple-300 mb-6">
        Passenger Details 👤
      </h2>

 <form action="/booking/passenger" method="POST" class="space-y-5">

  <div>
    <label class="block text-sm text-gray-300 mb-2">
      Full Name
    </label>

    <input
      type="text"
      name="name"
      required
      placeholder="Enter passenger full name"
      class="w-full p-3 rounded-lg bg-gray-800/60 border border-gray-600 text-white placeholder-gray-400 
      focus:outline-none focus:ring-2 focus:ring-orange-400 
      transition duration-300 transform focus:scale-[1.02] focus:shadow-lg"
    >
  </div>

  <div>
    <label class="block text-sm text-gray-300 mb-2">
      Email Address
    </label>

    <input
      type="email"
      name="email"
      required
      placeholder="example@email.com"
      class="w-full p-3 rounded-lg bg-gray-800/60 border border-gray-600 text-white placeholder-gray-400 
      focus:outline-none focus:ring-2 focus:ring-orange-400 
      transition duration-300 transform focus:scale-[1.02] focus:shadow-lg"
    >
  </div>

  <div>
    <label class="block text-sm text-gray-300 mb-2">
      Phone Number
    </label>

    <input
      type="tel"
      name="phone"
      required
      placeholder="+91 98765 43210"
      class="w-full p-3 rounded-lg bg-gray-800/60 border border-gray-600 text-white placeholder-gray-400 
      focus:outline-none focus:ring-2 focus:ring-orange-400 
      transition duration-300 transform focus:scale-[1.02] focus:shadow-lg"
    >
  </div>

  <!-- INFO -->
  <div class="bg-white/5 border border-white/10 rounded-lg p-3 text-sm text-gray-400">
    Your ticket and booking confirmation will be sent to this email address.
  </div>

  <!-- CTA -->
  <button
    type="submit"
    class="w-full bg-orange-500 hover:bg-orange-400 
    transition duration-300 transform hover:scale-[1.03] active:scale-[0.98] 
    text-white py-3 rounded-lg font-semibold shadow-md hover:shadow-orange-500/30"
  >
    Continue to Payment →
  </button>

  <!-- TRUST -->
  <div class="flex justify-center gap-4 text-xs text-gray-400 pt-2">
    <span>🔒 Secure</span>
    <span>⚡ Instant Booking</span>
    <span>💳 Razorpay</span>
  </div>

</form>

    </div>

  </div>
</div>

<%- include('../partials/footer') %>
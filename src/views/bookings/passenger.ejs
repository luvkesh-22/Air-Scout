<%- include('../partials/header') %>

<!-- SNOW BACKGROUND -->
<div class="snow-container fixed inset-0 z-[5] pointer-events-none"></div>

<!-- MAIN CONTENT -->
<div class="relative z-10 bg-transparent min-h-screen flex items-center justify-center px-4">
      <div class="w-full max-w-4xl grid md:grid-cols-2 gap-6">

    <!-- LEFT: FLIGHT SUMMARY -->
    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-lg">

      <h3 class="text-lg font-semibold text-gray-300 mb-4">
        Flight Summary ✈️
      </h3>

      <div class="text-white text-xl font-bold mb-2">
<%= flight.from_code %> → <%= flight.to_code %>      </div>

      <div class="text-gray-400 text-sm mb-4">
        Non-stop • 2h 45m
      </div>

      <!-- flight line -->
      <div class="flex items-center gap-2 mb-6">
        <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
        <div class="flex-1 h-[2px] bg-gray-600 relative">
          <span class="absolute left-1/2 -translate-x-1/2 text-xs">✈️</span>
        </div>
        <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
      </div>

      <div class="flex justify-between text-sm text-gray-400">
        <span>Departure</span>
       <%= new Date(flight.departure_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
      </div>

      <div class="flex justify-between text-sm text-gray-400 mb-6">
        <span>Arrival</span>
       <%= new Date(flight.arrival_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
      </div>

      <div class="text-orange-400 text-2xl font-bold">
        ₹ <%= flight.price %>
      </div>

    </div>


    <!-- RIGHT: PASSENGER FORM -->
<div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-lg animate-fadeUp">
      <h2 class="text-xl font-bold text-purple-300 mb-6">
        Passenger Details 👤
      </h2>

      <form action="/booking/passenger" method="POST" class="space-y-4">

      <input type="text" name="name" placeholder="Full Name"
  class="w-full p-3 rounded-lg bg-gray-800/60 border border-gray-600 text-white placeholder-gray-400 
  focus:outline-none focus:ring-2 focus:ring-orange-400 
  transition duration-300 transform focus:scale-[1.02] focus:shadow-lg">

       <input type="e-mail" name="email" placeholder="e-mail address"
  class="w-full p-3 rounded-lg bg-gray-800/60 border border-gray-600 text-white placeholder-gray-400 
  focus:outline-none focus:ring-2 focus:ring-orange-400 
  transition duration-300 transform focus:scale-[1.02] focus:shadow-lg">
    
  <input type="tel" name="phone" placeholder="Phone Number"
  class="w-full p-3 rounded-lg bg-gray-800/60 border border-gray-600 text-white placeholder-gray-400 
  focus:outline-none focus:ring-2 focus:ring-orange-400 
  transition duration-300 transform focus:scale-[1.02] focus:shadow-lg">

        <!-- CTA -->
        <button type="submit"
class="w-full bg-orange-500 hover:bg-orange-400 
transition duration-300 transform hover:scale-[1.03] active:scale-[0.98] 
text-white py-3 rounded-lg font-semibold shadow-md hover:shadow-orange-500/30">
          Continue to Payment →
        </button>

      </form>

    </div>

  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="snow-container fixed inset-0 z-[5] pointer-events-none"></div>

<div class="relative z-10 min-h-screen flex items-center justify-center px-4">

  <div class="max-w-md w-full bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl text-center animate-fadeUp">

    <div class="text-green-400 text-5xl mb-4">✔</div>

    <h2 class="text-2xl font-bold text-white mb-2">
      Booking Confirmed!
    </h2>

    <p class="text-gray-400 mb-6">
      Your ticket has been successfully booked ✈️
    </p>

    <!-- ticket card -->
    <div class="bg-gray-800/50 rounded-xl p-4 border border-gray-700 text-left mb-6">

      <div class="text-lg font-semibold mb-2">
        <%= booking.flight.from_code %> → <%= booking.flight.to_code %>
      </div>

      <p class="text-sm text-gray-400">
        Passenger: <%= booking.passenger.name %>
      </p>

      <p class="text-sm text-gray-400">
        Email: <%= booking.passenger.email %>
      </p>

      <p class="text-orange-400 font-bold mt-3">
        ₹ <%= booking.flight.price %>
      </p>

    </div>

    <!-- CTA -->
    <a href="/booking/bookings"
      class="block w-full bg-orange-500 hover:bg-orange-400 
      transition py-3 rounded-xl text-white font-semibold">
      View My Bookings →
    </a>

  </div>

</div>

<%- include('../partials/footer') %>
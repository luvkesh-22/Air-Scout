<%- include('../partials/header') %>

<!-- SNOW BG -->
<div class="snow-container fixed inset-0 z-[5] pointer-events-none"></div>

<div class="relative z-10 min-h-screen flex items-center justify-center px-4">

  <div class="w-full max-w-4xl grid md:grid-cols-2 gap-6 animate-fadeUp">

    <!-- LEFT: SUMMARY -->
    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl">

      <h3 class="text-lg font-semibold text-gray-300 mb-4">
        Flight Summary ✈️
      </h3>

      <div class="text-2xl font-bold mb-2">
        <%= flight.from_code %> → <%= flight.to_code %>
      </div>

      <div class="text-gray-400 text-sm mb-6">
        Non-stop • <%= flight.duration || '2h 45m' %>
      </div>

      <!-- route line -->
      <div class="flex items-center gap-2 mb-6">
        <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
        <div class="flex-1 h-[2px] bg-gray-600 relative">
          <span class="absolute left-1/2 -translate-x-1/2 text-xs">✈️</span>
        </div>
        <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
      </div>

      <div class="flex justify-between text-gray-400 text-sm">
        <span>Departure</span>
        <span>
          <%= new Date(flight.departure_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
        </span>
      </div>

      <div class="flex justify-between text-gray-400 text-sm mb-6">
        <span>Arrival</span>
        <span>
          <%= new Date(flight.arrival_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
        </span>
      </div>

      <div class="text-orange-400 text-3xl font-bold">
        ₹ <%= flight.price %>
      </div>

    </div>


    <!-- RIGHT: PAYMENT CARD -->
    <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-xl">

      <h2 class="text-xl font-bold text-purple-300 mb-6">
        Payment Details 💳
      </h2>

      <!-- passenger -->
      <div class="mb-6 space-y-2 text-sm text-gray-300">
        <p><span class="text-gray-400">Name:</span> <%= passenger.name %></p>
        <p><span class="text-gray-400">Email:</span> <%= passenger.email %></p>
      </div>

      <!-- payment box -->
      <div class="bg-gray-800/50 rounded-xl p-4 mb-6 border border-gray-700">
        <div class="flex justify-between text-gray-400 text-sm">
          <span>Ticket Price</span>
          <span>₹ <%= flight.price %></span>
        </div>

        <div class="flex justify-between text-gray-400 text-sm">
          <span>Convenience Fee</span>
          <span>₹ 0</span>
        </div>

        <div class="border-t border-gray-600 my-3"></div>

        <div class="flex justify-between text-white font-semibold text-lg">
          <span>Total</span>
          <span>₹ <%= flight.price %></span>
        </div>
      </div>

      <!-- PAY BUTTON -->
      <button onclick="payNow()"
        class="w-full bg-gradient-to-r from-orange-500 to-orange-600 
        hover:from-orange-400 hover:to-orange-500
        transition duration-300 transform hover:scale-[1.03] active:scale-[0.98]
        text-white py-3 rounded-xl font-semibold shadow-lg hover:shadow-orange-500/30">
        Pay Securely →
      </button>

      <p class="text-xs text-gray-500 mt-4 text-center">
        🔒 Secured by Razorpay
      </p>

    </div>

  </div>

</div>

<!-- Razorpay -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
async function payNow() {
  const res = await fetch("/booking/payment-success", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      razorpay_payment_id: "demo_" + Date.now()
    })
  });

  if (res.ok) {
    window.location.href = "/booking/success";
  } else {
    alert("Booking failed");
  }
}
</script>
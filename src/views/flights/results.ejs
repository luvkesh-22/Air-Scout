<%- include('../partials/header') %>

<h2 class="text-2xl font-bold mb-6 text-purple-700">Available Flights</h2>

<% if (flights.length === 0) { %>
  <p class="text-gray-600">No flights found</p>
<% } %>

<div class="grid gap-5">
<% flights.forEach(flight => { %>

  <div class="bg-white/10 backdrop-blur-lg border border-purple-400/20 rounded-xl shadow-lg p-5">

    <div>
      <p class="text-lg font-bold text-purple-700">
        <%= flight.from_city %> → <%= flight.to_city %>
      </p>
      <p class="text-gray-500 text-sm">Flight ID: <%= flight.id %></p>
      <p class="text-green-600 font-semibold text-lg">₹ <%= flight.price %></p>
    </div>

   <form action="/ticket" method="POST">
      <input type="hidden" name="flight_id" value="<%= flight.id %>" />

      <input type="number" name="user_id" placeholder="ID"
        class="border border-purple-200 p-2 rounded w-20 focus:ring-2 focus:ring-purple-400 outline-none" required />

      <button class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700 transition">
        Book
      </button>
    </form>

  </div>

<% }) %>
</div>

<%- include('../partials/footer') %>
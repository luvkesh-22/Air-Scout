<%- include('../partials/header') %>

<div class="min-h-screen relative overflow-hidden bg-[#06131f] flex items-center justify-center px-4 py-10">

  <!-- 🌌 Background Glow Effects -->
  <div class="absolute top-[-120px] left-[-120px] w-[320px] h-[320px] bg-orange-500/20 blur-3xl rounded-full"></div>
  <div class="absolute bottom-[-140px] right-[-100px] w-[300px] h-[300px] bg-pink-500/20 blur-3xl rounded-full"></div>

  <!-- ✈️ Animated Flight Path -->
  <svg
    class="absolute inset-0 w-full h-full opacity-40 pointer-events-none"
    viewBox="0 0 1200 800"
    preserveAspectRatio="none"
  >
    <path
      id="flightPath"
      d="M -100 100 C 300 50, 400 400, 700 350 S 1100 600, 1300 500"
      stroke="url(#pathGradient)"
      stroke-width="3"
      stroke-dasharray="10 10"
      fill="none"
    />

    <defs>
      <linearGradient id="pathGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#fb923c" />
        <stop offset="100%" stop-color="#ec4899" />
      </linearGradient>
    </defs>

    <text font-size="38" fill="#fb923c">
      ✈
      <animateMotion
        dur="12s"
        repeatCount="indefinite"
        rotate="auto"
      >
        <mpath href="#flightPath" />
      </animateMotion>
    </text>
  </svg>

  <!-- 🌟 Signup Card -->
  <div
    class="relative z-20 w-full max-w-md backdrop-blur-xl bg-white/10 border border-white/10 rounded-3xl shadow-2xl shadow-orange-500/10 p-8 md:p-10"
  >

    <!-- Heading -->
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-white tracking-tight">
        Create Account
      </h2>

      <p class="text-gray-300 text-sm mt-2">
        Start your premium journey with Air Scout ✨
      </p>
    </div>

    <!-- Form -->
    <form action="/auth/signup" method="POST" class="space-y-5">

      <!-- Full Name -->
      <div>
        <input
          type="text"
          name="name"
          placeholder="Full Name"
          required
          class="w-full px-4 py-3 rounded-2xl bg-white/10 border border-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition"
        />
      </div>

      <!-- Email -->
      <div>
        <input
          type="email"
          name="email"
          placeholder="Email Address"
          required
          class="w-full px-4 py-3 rounded-2xl bg-white/10 border border-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition"
        />
      </div>

      <!-- Password -->
      <div>
        <input
          type="password"
          name="password"
          placeholder="Password"
          required
          class="w-full px-4 py-3 rounded-2xl bg-white/10 border border-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition"
        />
      </div>

      <!-- Confirm Password -->
      <div>
        <input
          type="password"
          name="confirmPassword"
          placeholder="Confirm Password"
          required
          class="w-full px-4 py-3 rounded-2xl bg-white/10 border border-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition"
        />
      </div>

      <!-- Signup Button -->
      <button
        type="submit"
        class="w-full py-3 rounded-2xl bg-gradient-to-r from-orange-400 via-orange-500 to-pink-500 text-white font-semibold tracking-wide hover:scale-[1.02] hover:shadow-lg hover:shadow-orange-500/30 transition duration-300"
      >
        Create Account 🚀
      </button>

    </form>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-6">
      <div class="flex-1 h-px bg-white/10"></div>
      <span class="text-xs uppercase tracking-wider text-gray-400">
        or
      </span>
      <div class="flex-1 h-px bg-white/10"></div>
    </div>

    <!-- Google Button -->
    <a href="/auth/google" class="block">
      <button
        type="button"
        class="w-full py-3 rounded-2xl bg-white/10 border border-white/10 text-white font-medium hover:bg-white/15 hover:shadow-lg hover:shadow-orange-500/10 transition duration-300"
      >
        Continue with Google
      </button>
    </a>

    <!-- Login Link -->
    <p class="text-center text-sm text-gray-400 mt-6">
      Already have an account?
      <a
        href="/auth/login"
        class="text-orange-400 hover:text-orange-300 transition"
      >
        Login
      </a>
    </p>

  </div>
</div>

<%- include('../partials/footer') %>
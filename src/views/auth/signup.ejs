<%- include('../partials/header') %>

<div class="max-w-md mx-auto mt-12">

  <div class="bg-white/10 backdrop-blur-lg border border-purple-400/20 rounded-xl shadow-lg p-6">

    <h2 class="text-xl font-semibold text-center text-purple-300 mb-6">
      Create Account ✨
    </h2>

    <form action="/signup" method="POST" class="space-y-4">

      <input 
        type="text" 
        name="name" 
        placeholder="Full Name"
        class="w-full p-2 rounded bg-black/10 border border-purple-400/30 text-black placeholder-gray-400 focus:ring-2 focus:ring-purple-500 outline-none"
        required
      />

      <input 
        type="email" 
        name="email" 
        placeholder="Email"
        class="w-full p-2 rounded bg-black/10 border border-purple-400/30 text-black placeholder-gray-400 focus:ring-2 focus:ring-purple-500 outline-none"
        required
      />

      <input 
        type="password" 
        name="password" 
        placeholder="Password"
        class="w-full p-2 rounded bg-black/10 border border-purple-400/30 text-black placeholder-gray-400 focus:ring-2 focus:ring-purple-500 outline-none"
        required
      />

      <button 
        type="submit"
        class="w-full bg-gradient-to-r from-purple-600 to-pink-500 text-black py-2 rounded hover:opacity-90 transition"
      >
        Signup
      </button>

    </form>

    <p class="text-sm text-center mt-4 text-black-300">
      Already have an account?
      <a href="/login" class="text-purple-400 hover:underline">Login</a>
    </p>

  </div>
</div>

<%- include('../partials/footer') %>
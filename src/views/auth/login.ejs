<%- include('../partials/header') %>

<div class="min-h-screen relative bg-[#020817] px-4 overflow-hidden pt-28 pb-24">
      <!-- ✈️ Animated Flight Path -->

<!-- BOTTOM MAIN -->
<svg class="absolute -bottom-16 left-0 w-full h-40 opacity-50 pointer-events-none"
     viewBox="0 -10 1300 200">

  <path id="flightPath"
        d="M 0 180 Q 400 40 1000 180"
        stroke="#f59e0b"
        stroke-width="5"
        stroke-dasharray="8 6"
        fill="none"/>

  <text font-size="50" fill="#f59e0b">
    ✈
    <animateMotion dur="12s" repeatCount="indefinite">
      <mpath href="#flightPath"/>
    </animateMotion>
  </text>
</svg>

<!-- ✈️ FULL FLOW PATH -->
<svg class="absolute inset-0 w-full h-full opacity-70 pointer-events-none"
     viewBox="0 0 1100 800"
     preserveAspectRatio="none">

  <!-- LONG CURVE -->
  <path id="mainPath"
       d="M 1 140
   C 280 40, 480 340, 760 300
   S 980 520, 1120 420"
        stroke="#f59e0b"
        stroke-width="5"
        stroke-dasharray="8 6"
        fill="none"/>

  <!-- AIRPLANE -->
  <text font-size="50" fill="#f59e0b">
    ✈
    <animateMotion dur="12s" repeatCount="indefinite" rotate="auto">
      <mpath href="#mainPath"/>
    </animateMotion>
  </text>

</svg>
<svg class="absolute top-0 right-0 w-80 h-80 opacity-70 pointer-events-none z-0"
     viewBox="-30 30 300 300">

  <path id="topRightPath"
        d="M 20 40 Q 180 120 280 260"
        stroke="#f59e0b"
        stroke-width="5"
        stroke-dasharray="9 6"
        fill="none"/>

  <text font-size="50" fill="#f59e0b">
    ✈
    <animateMotion dur="10s" repeatCount="indefinite" rotate="auto">
      <mpath href="#topRightPath"/>
    </animateMotion>
  </text>

</svg>

<svg class="absolute left-0 top-1/2 -translate-y-1/2 w-96 h-96 opacity-70 pointer-events-none z-0"
     viewBox="0 0 300 300">

  <!-- LOOP PATH -->
  <path id="loopPath"
        d="
        M -80 150
        C 40 60, 160 40, 220 120
        C 280 200, 160 280, 80 220
        C 20 180, 60 140, 220 200
        "
        stroke="#fb923c"
        stroke-width="5"
        stroke-dasharray="8 6"
        fill="none"/>

  <!-- AIRPLANE -->
  <text font-size="50" fill="#fb923c">
    ✈
    <animateMotion dur="12s" repeatCount="indefinite" rotate="auto">
      <mpath href="#loopPath"/>
    </animateMotion>
  </text>

</svg>
<div class="absolute top-20 left-20 w-72 h-72 bg-orange-500/10 blur-[120px] rounded-full"></div>

<div class="absolute bottom-20 right-20 w-72 h-72 bg-pink-500/10 blur-[120px] rounded-full"></div>
<div class="relative z-20 w-full max-w-xl mx-auto">      <!-- Glow -->
<div class="absolute -inset-2 bg-gradient-to-r from-orange-500/30 via-pink-500/20 to-orange-400/20 blur-[70px] rounded-[48px]"></div>
  <!-- Card -->
<div class="relative backdrop-blur-[28px]
            bg-white/[0.05]
            border border-white/10
            shadow-[0_20px_80px_rgba(0,0,0,0.65)]
            rounded-[32px]
px-8 py-8 md:px-10 md:py-8
            overflow-hidden">
    <!-- Top Glow -->
<div class="absolute top-[-40px] left-1/2 -translate-x-1/2
            w-40 h-40
            bg-gradient-to-r from-orange-500/30 to-pink-500/20
            blur-3xl
            rounded-full">
</div>
    <!-- Plane Icon -->
    <div class="relative flex justify-center mb-6">

<div class="w-20 h-20 rounded-full
            bg-gradient-to-br from-orange-400 via-orange-500 to-pink-500
            flex items-center justify-center
            shadow-[0_10px_40px_rgba(249,115,22,0.55)]
            border border-white/20
            backdrop-blur-xl">

        <span class="text-3xltext-white">✈</span>

      </div>

    </div>

    <!-- Heading -->
    <div class="relative text-center mb-8">

<h2 class="text-3xl md:text-3xlfont-black text-white tracking-tight leading-tight">
          Welcome Back
      </h2>

<p class="text-gray-400 mt-3 text-sm tracking-wide">
          Login to continue your journey
      </p>

    </div>

    <!-- FORM -->
<form action="/auth/login" method="POST" class="space-y-4 mt-6 max-w-xl mx-auto">
      <!-- Email -->
      <div>

        <input
          type="email"
          name="email"
          placeholder="Email Address"
class="w-full px-5 py-3.5 rounded-xl
       bg-white/[0.03]
       border border-white/10
       text-white
       placeholder-gray-500
       backdrop-blur-xl
       focus:outline-none
       focus:ring-2
       focus:ring-orange-400/70
       focus:border-orange-400/40
       hover:border-white/20
       transition-all duration-300"
                 required
        />

      </div>

           <!-- Password -->
      <div>
        <input
          type="password"
          name="password"
          placeholder="Password"
          class="w-full px-5 py-3.5 rounded-xl
                 bg-white/[0.03]
                 border border-white/10
                 text-white
                 placeholder-gray-500
                 backdrop-blur-xl
                 focus:outline-none
                 focus:ring-2
                 focus:ring-orange-400/50
                 focus:border-orange-400/30
                 transition-all duration-300"
          required
        />
      </div>

      <!-- Login Button -->
      <button
        type="submit"
        class="w-full py-3.5 rounded-xl
               bg-gradient-to-r from-orange-500 to-pink-500
               text-white font-semibold text-lg
               border border-orange-300/10
               hover:opacity-90
               transition-all duration-300"
      >
        Login
      </button>

      <!-- Divider -->
      <div class="flex items-center gap-4 py-1">
        <div class="flex-1 h-px bg-white/10"></div>

        <span class="text-sm text-gray-500">
          or continue with
        </span>

        <div class="flex-1 h-px bg-white/10"></div>
      </div>

      <!-- Google Login -->
      <a
        href="/auth/google"
        class="w-full flex items-center justify-center gap-3
               py-3.5 rounded-xl
               bg-white/[0.03]
               border border-white/10
               text-white font-medium
               hover:bg-white/[0.05]
               transition-all duration-300"
      >
        <svg class="w-5 h-5" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.69 1.22 9.18 3.6l6.85-6.85C35.9 2.38 30.4 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.5 24.5c0-1.63-.15-3.2-.42-4.7H24v8.9h12.7c-.55 2.96-2.2 5.47-4.7 7.15l7.25 5.63C43.9 37.1 46.5 31.4 46.5 24.5z"/>
          <path fill="#FBBC05" d="M10.54 28.41A14.5 14.5 0 0 1 9.5 24c0-1.53.26-3 .72-4.41l-7.98-6.19A23.93 23.93 0 0 0 0 24c0 3.87.93 7.53 2.56 10.78l7.98-6.37z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.92-2.13 15.89-5.8l-7.25-5.63c-2.02 1.36-4.6 2.18-8.64 2.18-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.37C6.51 42.62 14.62 48 24 48z"/>
        </svg>

        Continue with Google
      </a>

    </form>
    <!-- Signup -->
<p class="text-center text-gray-500 text-sm mt-5 tracking-wide">
        Don’t have an account?

      <a
        href="/auth/signup"
        class="text-orange-400 hover:text-orange-300 font-medium transition"
      >
        Create Account
      </a>
    </p>

</div>
</div>

<div class="h-24"></div>

<%- include('../partials/footer') %>
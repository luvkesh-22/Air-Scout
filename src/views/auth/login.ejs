<%- include('../partials/header') %>

<div class="max-w-md mx-auto mt-10">
  
  <h2 class="text-2xl font-bold mb-6 text-center text-purple-300">
    Login
  </h2>

  <div class="bg-black/10 backdrop-blur-lg border border-purple-400/20 rounded-xl shadow-lg p-6">
    
    <form action="/login" method="POST" class="space-y-4">

      <input 
        type="email" 
        name="email" 
        placeholder="Email"
        class="w-full p-2 rounded bg-black/30 border border-purple-400/30 text-white placeholder-gray-300 focus:ring-2 focus:ring-purple-500 outline-none"
        required 
      />

      <input 
        type="password" 
        name="password" 
        placeholder="Password"
        class="w-full p-2 rounded bg-black/30 border border-purple-400/30 text-white placeholder-gray-300 focus:ring-2 focus:ring-purple-500 outline-none"
        required 
      />

      <button 
        type="submit"
        class="w-full bg-gradient-to-r from-purple-600 to-pink-500 text-white py-2 rounded hover:opacity-90 transition"
      >
        Login
      </button>
 <p class="text-sm text-center mt-4 text-black/50">
        Don’t have an account?
        <a href="/signup" class="text-purple-400 hover:underline">Signup</a>
        </p> 
    </form>

  </div>
</div>

<%- include('../partials/footer') %>
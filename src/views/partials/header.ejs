<head>
  <title>Air Scout</title>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
  tailwind.config = {
    darkMode: 'class'
  }
</script>
<script src="https://cdn.tailwindcss.com"></script>

  <!-- FONT -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
  <style>
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeUp {
  animation: fadeUp 0.7s ease-out;
}
</style>
<style>
.snow-container {
  position: fixed;
  inset: 0;
  z-index: 5;
  pointer-events: none;
}
.snowflake {
  color: rgba(255,255,255,0.9);
  font-size: 14px;
  text-shadow: 0 0 8px rgba(255,255,255,0.8);
}
.snowflake {
  position: absolute;
  top: -10px;
 color: rgba(255,255,255,0.9);
  font-size: 14px;
  opacity: 0.8;
  animation: fall linear infinite;
  text-shadow: 0 0 8px rgba(255,255,255,0.9);
}

@keyframes fall {
  0% {
    transform: translateY(-10px);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  100% {
    transform: translateY(100vh);
    opacity: 0;
  }
}
</style>

<style>
    
.handwritten {
  font-family: 'Pacifico', cursive;
  color: #f59e0b;
  display: inline-block;
}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {

  // 🌙 THEME TOGGLE
  const btn = document.getElementById('themeToggle');
  const icon = document.getElementById('themeIcon');

  

  // ❄️ SNOW EFFECT
  const container = document.querySelector('.snow-container');
  if (!container) return;

  for (let i = 0; i < 60; i++) {
    const snow = document.createElement('div');
    snow.className = 'snowflake';
    snow.innerHTML = '❄';

    snow.style.left = Math.random() * 100 + 'vw';
    snow.style.animationDuration = (5 + Math.random() * 6) + 's';
    snow.style.fontSize = (10 + Math.random() * 12) + 'px';
    snow.style.opacity = Math.random();

    container.appendChild(snow);
  }

});

</script>
</head>

<body class="font-[Inter] bg-gray-900 text-white">
   <div class="w-full flex justify-end items-center gap-4 p-4 bg-black/20"><div class="flex items-center gap-4">

  <!-- NAV LINKS -->
  <a href="/" class="text-white hover:text-orange-400">Flights</a>
  <a href="#" class="text-white hover:text-orange-400">Hotels</a>
  <a href="#" class="text-white hover:text-orange-400">Trains</a>
  <a href="#" class="text-white hover:text-orange-400">Bus</a>

  <!-- MY TRIPS -->
  <a href="/my-trips"
     class="text-white hover:text-orange-400 font-medium">
     My Trips
  </a>

</div>

  <% if (locals.user) { %>
    <div class="text-white">
      Welcome, <%= user.name %>
      <a href="/auth/logout" class="ml-3 text-orange-400">Logout</a>
    </div>
  <% } else { %>
    <a href="/auth/login"
       class="bg-orange-500 text-white px-4 py-1 rounded-lg hover:bg-orange-600">
       Login
    </a>
  <% } %>

  <!-- 🌙 TOGGLE HERE -->
 <button id="themeToggle"
  class="ml-3 px-3 py-1 rounded-lg bg-gray-700 text-white">
  🌙
</button>

</div>

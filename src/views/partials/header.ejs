<!DOCTYPE html>
<html lang="en">

<head>
  <title>Air Scout</title>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
  tailwind.config = {
    darkMode: 'class'
  }
</script>

<script src="https://cdn.tailwindcss.com"></script>
<style>
/* 🌙 PREMIUM GLASS */
.glass {
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  background: rgba(15, 23, 42, 0.72);

  border: 1px solid rgba(255,255,255,0.08);

  box-shadow:
    0 8px 32px rgba(0,0,0,0.35),
    inset 0 1px 0 rgba(255,255,255,0.04);
}
/* ✨ Premium Form Styling */
/* 🎯 Scoped search form styling */

/* 🎯 Premium search form */


.glass select {
  background: rgba(255,255,255,0.06);

  border: 1px solid rgba(255,255,255,0.08);

  color: white;
}

.glass input::placeholder {
  color: rgba(255,255,255,0.55);
}

.glass label,
.glass p,
.glass span {
  color: rgba(255,255,255,0.85);
}

/* ✨ Hover */
.glass-hover:hover {
  transform: translateY(-4px) scale(1.01);
  transition: all 0.25s ease;
}

/* 💎 Glow */
.glow {
  box-shadow: 0 0 20px rgba(255, 165, 0, 0.2);
}
</style>
  <!-- FONT -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
  <style>
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeUp {
  animation: fadeUp 0.7s ease-out;
}
</style>
<style>
.snow-container {
  position: fixed;
  inset: 0;
  z-index: 5;
  pointer-events: none;
}
.snowflake {
  color: rgba(255,255,255,0.9);
  font-size: 14px;
  text-shadow: 0 0 8px rgba(255,255,255,0.8);
}
.snowflake {
  position: absolute;
  top: -10px;
 color: rgba(255,255,255,0.9);
  font-size: 14px;
  opacity: 0.8;
  animation: fall linear infinite;
  text-shadow: 0 0 8px rgba(255,255,255,0.9);
}

@keyframes fall {
  0% {
    transform: translateY(-10px);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  100% {
    transform: translateY(100vh);
    opacity: 0;
  }
}
</style>

<style>
    
.handwritten {
  font-family: 'Pacifico', cursive;
  color: #f59e0b;
  display: inline-block;
}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
  

  // ❄️ SNOW EFFECT
  const container = document.querySelector('.snow-container');
  if (!container) return;

  for (let i = 0; i < 60; i++) {
    const snow = document.createElement('div');
    snow.className = 'snowflake';
    snow.innerHTML = '❄';

    snow.style.left = Math.random() * 100 + 'vw';
    snow.style.animationDuration = (5 + Math.random() * 6) + 's';
    snow.style.fontSize = (10 + Math.random() * 12) + 'px';
    snow.style.opacity = Math.random();

    container.appendChild(snow);
  }

});

</script>
</head>

<body class="font-[Inter] text-white min-h-screen overflow-x-hidden bg-gradient-to-br from-[#020617] via-[#071226] to-[#0b1120]">
<nav class="glass rounded-3xl border border-white/10 shadow-2xl px-6 py-4 flex items-center justify-between glass-hover max-w-7xl mx-auto mt-4">
  <!-- LEFT -->
  <div class="flex items-center gap-6">

  <a href="/flights/search"
    class="text-white hover:text-orange-400 transition">
    Flights
  </a>

  <a href="/hotels"
    class="text-white hover:text-orange-400 transition">
    Hotels
  </a>

  <a href="/trains"
    class="text-white hover:text-orange-400 transition">
    Trains
  </a>

  <a href="/bus"
    class="text-white hover:text-orange-400 transition">
    Bus
  </a>

  <a href="/booking/bookings"
    class="text-white hover:text-orange-400 font-medium transition">
    My Trips
  </a>

</div>
  <!-- RIGHT -->
  <div class="flex items-center gap-4">

    <% if (locals.user) { %>

      <div class="text-white">
        Welcome, <%= locals.user.name %>

        <a href="/auth/logout"
          class="ml-3 text-orange-400">
          Logout
        </a>
      </div>

   <% } else { %>

  <div class="flex items-center gap-3">

   <a href="/auth/login"
  class="bg-white/10 text-white px-4 py-2 rounded-xl hover:bg-white/20 transition">
  Login
</a>

    <a href="/auth/signup"
      class="bg-gradient-to-r from-orange-500 to-pink-500 text-white px-4 py-2 rounded-xl hover:scale-105 transition">
      Signup
    </a>

  </div>

<% } %>

   

  </div>

</nav>